rules_version = '2';

// DStudio access list: one document per allowed e-mail, in the "allowed" collection,
// whose id is the e-mail in lower case (e.g. allowed/jane.doe@gmail.com).
// A signed-in user with a verified e-mail can only check their own document. Nothing else is readable or writable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /allowed/{email} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }
  }
}
